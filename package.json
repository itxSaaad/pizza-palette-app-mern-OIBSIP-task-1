{
  "name": "pizza-delivery-system-app-mern",
  "version": "1.0.0",
  "description": "A Full-Stack Web Application that simulates a Dynamic Pizza Delivery System.",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "start": "pnpm --filter server start",
    "server": "pnpm --filter server dev",
    "client": "pnpm --filter client dev",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:import": "node server/seeder",
    "data:destroy": "node server/seeder -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itxSaaad/pizza-delivery-system-app-mern-OIBSIP.git"
  },
  "keywords": [
    "nodejs",
    "mongodb",
    "reactjs",
    "expressjs",
    "mern-stack",
    "pizza-delivery-system",
    "internship-task",
    "oasis-internship",
    "oibsip"
  ],
  "author": "Muhammad Saad",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/itxSaaad/pizza-delivery-system-app-mern-OIBSIP/issues"
  },
  "homepage": "https://github.com/itxSaaad/pizza-delivery-system-app-mern-OIBSIP#readme",
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0"
  }
}
