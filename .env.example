# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (used in emails, CORS, etc.)
# For production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB Connection (Docker Container)
# Option 1: If using existing mongo-dev container (no auth)
MONGO_URI=mongodb://localhost:27017/pizza-delivery-app

# Option 2: If using docker-compose.yml with authentication
# MONGO_URI=mongodb://admin:password123@localhost:27017/pizza-delivery-app?authSource=admin

# Authentication
# Generate a strong secret for production: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
SALT=10

# Email Configuration (Nodemailer)
# Defaults to Zoho Mail's global SMTP (smtp.zoho.com:465). Generate an
# app-specific password in Zoho Mail: Settings > Security > App Passwords.
# To use a different provider (Gmail, Outlook, etc.), override SMTP_HOST/
# SMTP_PORT/SMTP_SECURE below.
SENDER_EMAIL=your_email@example.com
SENDER_PASSWORD=your_email_app_password
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Payment Gateway (Stripe)
# See docs/STRIPE_SETUP.md for how to get these values.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Automatic low-stock checks
# Local/traditional hosting: runs via node-cron in-process, no config needed
# (optionally override the schedule with LOW_STOCK_CHECK_CRON, standard
# 5-field cron syntax, default "0 8 * * *" = daily at 8am server time).
# Vercel (serverless): set CRON_SECRET here AND as a Vercel project env var —
# Vercel Cron Jobs (see server/vercel.json) send it as a Bearer token to
# authenticate the scheduled request in place of an admin session.
# LOW_STOCK_CHECK_CRON=0 8 * * *
CRON_SECRET=your_random_cron_secret