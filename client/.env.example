# Server URL
VITE_SERVER_URL=http://localhost:5000/api

# Client URL (Vite default port is 5173)
VITE_CLIENT_URL=http://localhost:5173

# No Stripe configuration is needed here — checkout redirects to a
# Stripe-hosted page server-side, the client never handles card details
# or a Stripe publishable key directly. See docs/STRIPE_SETUP.md.
